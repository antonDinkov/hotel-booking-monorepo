# Database
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DB_SSL=true

# Auth.js / NextAuth JWT sessions
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Optional GitHub OAuth provider used by the current auth configuration
GITHUB_ID=
GITHUB_SECRET=

# Password hashing
BCRYPT_SALT_ROUNDS=12

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_APP_URL=http://localhost:3000
MOBILE_APP_SCHEME=mobile

# Mobile / Expo Web CORS
MOBILE_CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Cloudflare R2 object storage
R2_ENDPOINT=https://account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=hotel-booking-assets
R2_PUBLIC_URL=https://assets.example.com
NEXT_PUBLIC_R2_PUBLIC_URL=https://assets.example.com
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me

# Optional diagnostics
AUTH_DEBUG_SESSION=false
REVIEWS_DEBUG_BADGE=false
