{
  "name": "hotel-booking",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "dev:mobile": "npm run startLocal --workspace=mobile",
    "typecheck:web": "npm run typecheck --workspace=web",
    "typecheck:mobile": "npm run typecheck --workspace=mobile",
    "build:web": "npm run build --workspace=web",
    "build:mobile:web": "npm run build:web --workspace=mobile"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "expo-router": "~55.0.14"
  }
}
